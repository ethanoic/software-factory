# Copy to .env.factory and `chmod 600 .env.factory`. Never commit it.

# --- Claude Pro (D3). Not stored here any more: run `make claude-token` on the Mac. It uses your
# current claude.ai login and writes secrets/claude_oauth_token. Leave this blank (it is only a fallback).
CLAUDE_CODE_OAUTH_TOKEN=
# Leave ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN unset while anthropic_route = subscription:
# Claude Code ranks both above the plan token.
# ANTHROPIC_API_KEY=

# --- The factory's own database (created by `make up` on first start). `make init` fills these in
# with random passwords. Change them only before the first `make up`: the database keeps the first ones.
FACTORY_DB_PASSWORD=change-me
# The board's read-only database role
FACTORY_BOARD_DB_PASSWORD=change-me-too

# --- Optional: Langfuse traces (off by default). To turn on, run Langfuse yourself, then set:
# LANGFUSE_DISABLED=0
# LANGFUSE_HOST=http://host.docker.internal:3000     (where the factory reaches it)
# LANGFUSE_PUBLIC_URL=http://localhost:3000          (where your browser reaches it)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Alerts: Slack incoming webhook or ntfy topic URL (optional; alerts also go to container logs)
ALERT_WEBHOOK_URL=

# --- Optional providers. Not used by coding roles (labs: [anthropic]); kept for discovery/qualification.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# The factory refuses to run tickets against its own repo. Change this only if you forked the factory
# (comma-separated owner/name).
FACTORY_SELF_REPOS=ethanoic/software-factory
